<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default configuration for all domains - use system certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Special configuration for app.sivakundalini.org and pub-*.r2.dev domains -->
    <!-- This trusts user-installed certificates in addition to system certificates -->
    <!-- Allows the app to work with self-signed or incomplete certificate chains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">sivakundalini.org</domain>
        <domain includeSubdomains="true">r2.dev</domain>
        <trust-anchors>
            <!-- Trust system certificates -->
            <certificates src="system" />
            <!-- Also trust user-installed certificates (for testing/development) -->
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
